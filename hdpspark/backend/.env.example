# HDP Spark Backend - Production Environment Variables

# CORS: comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Server
WORKERS=4
LOG_LEVEL=info

# Jira Cloud API (optional - for direct Jira integration)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence API (optional)
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Upload limits
MAX_UPLOAD_SIZE_MB=50
